# Default
* text=auto

# Source code / configs / docs
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Windows scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files
*.pt   binary
*.pth  binary
*.ckpt binary
*.zip  binary
*.rar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
